# ${GATEWAY_URL} and ${NGINX_RESOLVER} are substituted at container start (nginx does this
# for /etc/nginx/templates/*.template), so one image runs in any environment.
# nginx's own $uri / $host survive: envsubst only replaces names that exist in the environment.

# Log the path without its query string. The web app sends tokens only in headers, but a query
# can still carry something private, and anyone who can read the container logs reads this.
map $request_uri $path_only {
    ~^(?<path_part>[^?]*) $path_part;
}
log_format no_query '$remote_addr - [$time_local] "$request_method $path_only $server_protocol" '
                    '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    access_log /var/log/nginx/access.log no_query;

    # nginx's own default is 1M, far under a real paper with figures; a request past this
    # limit fails at nginx with a bare 413 before the gateway (which has no limit of its
    # own) ever sees it.
    client_max_body_size 100M;

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }

    # The pdf.js worker is an .mjs file. nginx's mime.types does not list .mjs, and a browser
    # refuses to run a module worker served as application/octet-stream.
    location ~ \.mjs$ {
        root /usr/share/nginx/html;
        default_type text/javascript;
        types { }
    }

    location /api/ {
        # Resolving through a variable makes nginx look the gateway up per request instead of
        # once at startup — otherwise restarting the gateway strands this container on a dead IP.
        resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
        set $gateway ${GATEWAY_URL};
        rewrite ^/api/?(.*)$ /$1 break;
        proxy_pass $gateway;

        proxy_http_version 1.1;
        proxy_set_header Host $host;

        # server-sent events must not be buffered or timed out
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
    }
}
