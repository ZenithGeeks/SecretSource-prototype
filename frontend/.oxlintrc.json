{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "no-restricted-imports": [
      "error",
      {
        "paths": [
          {
            "name": "framer-motion",
            "importNames": ["motion"],
            "message": "Render m.* instead: the app loads animations through LazyMotion in src/main.tsx, and motion.* pulls the whole library back in (SCRUM-527)."
          }
        ]
      }
    ]
  }
}
