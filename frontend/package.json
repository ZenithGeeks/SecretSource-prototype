{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --max-warnings 65",
    "test": "npm run test:legacy && npm run test:vitest",
    "test:legacy": "jiti tests/index.test.ts",
    "test:vitest": "vitest run",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "dev:e2e": "vite --port 5174 --strictPort --mode e2e",
    "e2e": "start-server-and-test dev:e2e http://localhost:5174 \"cypress run\"",
    "e2e:open": "start-server-and-test dev:e2e http://localhost:5174 \"cypress open\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@supabase/auth-js": "^2.116.0",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.3",
    "cytoscape-cola": "^2.5.1",
    "framer-motion": "^13.4.4",
    "latex.js": "^0.12.6",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-cytoscapejs": "^2.0.0",
    "react-dom": "^19.2.8",
    "react-pdf": "^10.5.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "webcola": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.1",
    "cypress": "^16.2.1",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "fflate": "^0.8.3",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.1"
  }
}
