# Everything on this machine, on one NVIDIA GPU: vLLM, ColBERT, ColPali, GROBID, the gateway and
# the web app. Every URL is empty, so compose uses its own containers. Copy to .env, then:
# docker compose --profile gpu --profile vision up -d. Check with: curl localhost:8080/health
# Every setting is explained in .env.example.

# --- network ---
BIND_ADDRESS=

# --- keys ---
HF_TOKEN=
# Close to required: most cited papers do not resolve without it.
S2_API_KEY=
UNPAYWALL_EMAIL=

# --- LLM ---
# Empty means the vllm container.
VLLM_URL=
VLLM_MODEL=
VLLM_API_KEY=
VLLM_HF_MODEL=Qwen/Qwen3.5-4B
VLLM_SERVED_NAME=qwen
VLLM_QUANT=fp8
VLLM_MAX_LEN=8192
# 0.88 with --profile vision, as below; 0.6 without it. .env.example explains why.
VLLM_GPU_UTIL=0.88

# --- retrieval and parsing ---
# Empty means the colbert and colpali containers.
COLBERT_URL=
COLPALI_URL=
COLPALI_MODEL=vidore/colqwen2-v1.0
GROBID_URL=
SERVICE_AUTH=none

# --- persistence ---
# Empty means SQLite in the analyses volume, and no sign-in.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
