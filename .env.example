# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Optional: a Hugging Face token only raises the Hub's anonymous download rate limit.
# Every model this stack uses is public, so the services run without it.
HF_TOKEN=

# Optional but close to necessary: Semantic Scholar 429s unauthenticated callers most of
# the time, and without a key most cited papers never resolve. Free from
# https://www.semanticscholar.org/product/api
S2_API_KEY=

# Optional: a contact address lets Unpaywall answer when Semantic Scholar will not.
UNPAYWALL_EMAIL=

# How many claims one paper may yield. 0 keeps every claim (what the benchmark wants).
CLAIM_LIMIT=20

# Share of the GPU vLLM may occupy, counting memory other processes already hold.
# 0.6 suits the default stack. With `--profile vision` the ColQwen2 server needs ~4 GiB of
# the same card, so raise this and start colbert and colpali before vllm:
#   VLLM_GPU_UTIL=0.88
VLLM_GPU_UTIL=0.6

# Which checkpoint vLLM loads. The default suits a 16 GB card shared with ColBERT; a card
# with room wants Qwen/Qwen3.5-9B (better judge, same stack). An already-quantized
# checkpoint (Qwen/Qwen3.5-27B-GPTQ-Int4) needs VLLM_QUANT=gptq_marlin.
# VLLM_SERVED_NAME is the id the gateway asks for; leave it alone.
VLLM_HF_MODEL=Qwen/Qwen3.5-4B
VLLM_SERVED_NAME=qwen
VLLM_QUANT=fp8
VLLM_MAX_LEN=8192

# Where the model answers. Unset means the vllm container in docker-compose. Point it at a
# Cloud Run service instead and the local GPU is out of the picture — see deploy/vllm-cloud-run.md:
#   VLLM_URL=https://vllm-xxxxxxxx-as.a.run.app/v1
VLLM_URL=

# The key that vLLM was started with, if any. The Cloud Run deploy starts it behind one,
# because a public /v1/chat/completions is a free LLM for whoever finds the URL. The local
# container has no key and ignores whatever is sent.
VLLM_API_KEY=

# Vision retrieval checkpoint (see services/colpali/encoder.py for the trade-offs).
COLPALI_MODEL=vidore/colqwen2-v1.0

# Where the vector database answers. Unset means the qdrant container in docker-compose
# (host runs then want http://localhost:6333). A Qdrant Cloud cluster URL here moves both
# retrieval indexes to the cloud; QDRANT_API_KEY is the cluster's key.
QDRANT_URL=
QDRANT_API_KEY=
