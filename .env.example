# Copy to .env and fill in. .env is gitignored — never commit a real token.
#
# docker compose and host runs (uvicorn, backend/cli.py, tests) read this same file. For
# every *_URL below, empty means "the compose container"; a value means "that service,
# wherever it is". Three ways to run, all decided here:
#
#   Everything local (NVIDIA GPU)   leave the URLs empty     docker compose --profile gpu up -d
#   Local gateway, cloud services   fill in the URLs below   docker compose up -d
#   Host run (no Docker for the     same URLs, but localhost python -m uvicorn app.main:app
#   gateway)                        instead of container names

# --- network ---------------------------------------------------------------------

# The address compose publishes ports on. Empty means 127.0.0.1: only this machine can open
# the web app, the gateway and the services, because none of them checks who is calling. To
# share the stack with teammates over Tailscale, set this machine's Tailscale IP
# (`tailscale ip -4`) and open http://<that IP>:5173 yourself too. Qdrant stays on 127.0.0.1
# whatever this says: anyone who reaches it can delete every index.
BIND_ADDRESS=

# --- keys ----------------------------------------------------------------------

# Optional: a Hugging Face token only raises the Hub's anonymous download rate limit.
HF_TOKEN=

# Close to required: Semantic Scholar 429s unauthenticated callers most of the time, and
# without a key most cited papers never resolve. Free from
# https://www.semanticscholar.org/product/api
S2_API_KEY=

# Optional: a contact address lets Unpaywall answer when Semantic Scholar will not.
UNPAYWALL_EMAIL=

# How many claims one paper may yield. 0 keeps every claim (what the benchmark wants).
CLAIM_LIMIT=20

# How much runs at the same time. PARALLEL_SOURCES: cited papers downloaded and indexed at once
# (indexing uses the GPU services, keep it small). PARALLEL_CHECKS: claims judged at once
# (search + LLM). Raise PARALLEL_CHECKS only if your LLM endpoint accepts that many requests.
PARALLEL_SOURCES=3
PARALLEL_CHECKS=3

# The same limits for the whole gateway, across every analysis running at once. Empty means
# the per-run value above, so two analyses together make the load of one and take turns.
# Raise them when the GPU services and the LLM endpoint can take more.
PARALLEL_SOURCES_TOTAL=
PARALLEL_CHECKS_TOTAL=

# When Docling runs OCR while it reads a paper's figures. auto: only on a PDF without a text
# layer (a scan). OCR on a born-digital paper doubles the time and finds nothing new.
DOCLING_OCR=auto
# How long a cited paper's checks wait for its figures. Empty: until they are indexed, so the
# judge can read the captions. Seconds (0 is fastest): a fast mode that judges on the text alone
# after that; a later run of the paper gets the figures. 0 got one verdict in 15 wrong.
FIGURE_WAIT=

# --- LLM -----------------------------------------------------------------------

# Any OpenAI-compatible vLLM. Empty VLLM_URL means the vllm container (--profile gpu).
#   VLLM_URL=https://<host>/v1
#   VLLM_MODEL=<an id that {VLLM_URL}/models lists>
#   VLLM_API_KEY=<the key that server was started with>
# The gateway asks for enable_thinking=false on every request (backend/app/llm.py), so a
# Qwen3 endpoint that thinks by default works as well as one that does not.
VLLM_URL=
VLLM_MODEL=
VLLM_API_KEY=

# The vllm container only (--profile gpu): which checkpoint, how, and how much of the card.
# The 4B default fits a 16 GB card beside ColBERT; 0.6 is the share of the whole card. With
# --profile vision the ColQwen2 server needs ~4 GiB of the same card, so raise it to 0.88
# and start colbert and colpali first. VLLM_SERVED_NAME is the id the container answers to.
VLLM_HF_MODEL=Qwen/Qwen3.5-4B
VLLM_SERVED_NAME=qwen
VLLM_QUANT=fp8
VLLM_MAX_LEN=8192
VLLM_GPU_UTIL=0.6

# --- retrieval and parsing -------------------------------------------------------

# Empty means the colbert / colpali containers (--profile gpu / --profile vision). The
# shared ones are https://colbert-540627595710.asia-southeast1.run.app and
# https://colpali-540627595710.asia-southeast1.run.app.
COLBERT_URL=
COLPALI_URL=

# Vision retrieval checkpoint (see services/colpali/encoder.py for the trade-offs).
COLPALI_MODEL=vidore/colqwen2-v1.0

# Empty means the grobid container, which every profile starts. Host run: http://localhost:8070.
GROBID_URL=

# The shared Cloud Run services only accept callers with a Google identity token. Set
# SERVICE_AUTH=google-id-token and the gateway attaches one to every *.run.app URL above
# (never to other hosts); `none` sends nothing, which is all the compose containers need.
# On Cloud Run the gateway's own service account supplies the token. Locally it comes from
# the credentials file below — put it in backend/secrets/ (gitignored, kept out of images):
#   gcloud auth application-default login --impersonate-service-account=<invoker SA email>
#   cp <the credentials file that command prints> backend/secrets/service-auth.json
# or a service-account key saved as the same file. A plain `gcloud auth login` user cannot
# mint identity tokens. The relative path works for compose and for a host run from backend/.
SERVICE_AUTH=none
GOOGLE_APPLICATION_CREDENTIALS=

# Only colbert and colpali talk to Qdrant. Empty means the qdrant container; a cluster URL
# (the team's GCE VM, or Qdrant Cloud) moves both indexes there and QDRANT_API_KEY is its
# key. Host run of a retrieval service: http://localhost:6333.
QDRANT_URL=
QDRANT_API_KEY=

# --- persistence -----------------------------------------------------------------

# Where the gateway stores analyses and resolved-source lookups. Empty = SQLite at
# ANALYSES_DB (default, local). Set BOTH to use Supabase Postgres instead: the project's
# API URL and its SERVICE ROLE key (Dashboard -> Settings -> API). The service role bypasses
# RLS — it is server-only, never shipped to the browser. Never commit a real key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Turns on sign-in in the web app, and each user then sees only their own analyses.
# Needs SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY above too, so the gateway can check who is
# signed in. Dashboard -> Settings -> API: the project URL and the anon (public) key.
# Rebuild the web image after changing these: docker compose up -d --build web
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Teacher-only Google Classroom connection. Keep secrets server-side; the callback is served
# through the web origin's /api proxy, for example http://localhost:5173/api/teacher/google/callback.
TEACHER_GOOGLE_ENABLED=false
TEACHER_GOOGLE_CLIENT_ID=
TEACHER_GOOGLE_CLIENT_SECRET=
TEACHER_GOOGLE_REDIRECT_URI=
TEACHER_GOOGLE_SUCCESS_REDIRECT=/?role=teacher&screen=add-class-course
TEACHER_GOOGLE_ENCRYPTION_KEY=
VITE_TEACHER_BACKEND=mock

# Optional. Keeps the chat agents' sessions (backend/cli.py, the A2A server) after a restart.
# A Postgres URL. For Supabase: Dashboard -> Connect -> Session pooler, port 5432, with your
# database password. This is not SUPABASE_URL. Empty: sessions live in memory, as before.
# DIRECT_URL is read too, if you already have the URL under that name.
SESSION_DB_URL=

# Optional. The chat agents' load_memory tool answers from saved analyses. It reads the ones
# without an owner (all of them when sign-in is off) and the ones owned by this Supabase user id.
# The chat agents do not know who is asking, so they never read anyone else's.
MEMORY_OWNER=
