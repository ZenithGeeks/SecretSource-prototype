# Teammate .env for development: copy to the repo root as .env, then fill in your personal
# key from the host. Never commit the filled-in file.
#
# Runs grobid, redis, gateway, worker and web on your own machine (no GPU needed):
#   docker compose up -d --build        then open http://localhost:5173
# ColBERT and the judge LLM come from the host's team gateway over Tailscale, so Tailscale
# must be connected.

BIND_ADDRESS=127.0.0.1

# Your personal key from the host (starts with sk-). It goes in an `apikey` header to
# COLBERT_URL and COLPALI_URL only. The same key is your VLLM_API_KEY below.
SERVICE_AUTH=api-key
SERVICE_API_KEY=

# GPU services behind the team gateway.
COLBERT_URL=https://wttw-1.tailcf73b7.ts.net:8443/colbert
# ColPali (figure search) is usually off on the host; calls to it are skipped while it is down.
COLPALI_URL=https://wttw-1.tailcf73b7.ts.net:8443/colpali
# grobid runs in your own compose stack, so GROBID_URL stays empty.
GROBID_URL=

# The judge LLM through the team gateway. The provider key stays on the host.
# The team shares 3 calls at a time and your key allows 1, so keep both of these at 1:
# with more, your extra calls are refused at once (HTTP 429).
VLLM_URL=https://wttw-1.tailcf73b7.ts.net:8443/llm/v1
VLLM_MODEL=qwen3.8-27b-fp8
VLLM_API_KEY=
PARALLEL_CHECKS=1
LLM_PARALLEL_REQUESTS=1

# Source lookups. Ask the host, or make your own free keys (links in .env.example).
S2_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
SCOPUS_API_KEY=

# Empty: analyses go to a local SQLite file and login is off. This is the default for
# development. Fill these only for work on login or labeling, with a local Supabase
# (`supabase start`, migrations in supabase/migrations) rather than the team's project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The team gateway, for the MCP URL and key page in Settings -> Agents.
VITE_GATEHOUSE_URL=https://wttw-1.tailcf73b7.ts.net:8443

REDIS_URL=
