# Teammate .env for development: copy to the repo root as .env, then fill in the keys the
# host sends you privately. Never commit the filled-in file.
#
# Runs grobid, redis, gateway, worker and web on your own machine (no GPU needed):
#   docker compose up -d --build        then open http://localhost:5173
# ColBERT comes from the host over Tailscale, so Tailscale must be connected.

BIND_ADDRESS=127.0.0.1

# GPU services on the host. Tailnet only: Tailscale is what keeps everyone else out.
COLBERT_URL=https://wttw-1.tailcf73b7.ts.net:8893
# ColPali (figure search) is off under compose; ask the host if you need it shared.
# grobid runs in your own compose stack, so GROBID_URL stays empty.
GROBID_URL=
SERVICE_AUTH=none

# The judge LLM. One shared key: 3 requests at a time for the whole team, and a fixed budget.
# Keep these at 1 while developing so you do not block the labelers' analyses.
VLLM_URL=https://gateway.9arm.co/v1
VLLM_MODEL=qwen3.8-27b-fp8
VLLM_API_KEY=
PARALLEL_CHECKS=1
LLM_PARALLEL_REQUESTS=1

# Source lookups. Ask the host, or make your own free keys (links in .env.example).
S2_API_KEY=
OPENALEX_API_KEY=
UNPAYWALL_EMAIL=
SCOPUS_API_KEY=

# Empty: analyses go to a local SQLite file and login is off. This is the default for
# development. Fill these only for work on login or labeling, with a local Supabase
# (`supabase start`, migrations in supabase/migrations) rather than the team's project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

REDIS_URL=
PAPERS_BUCKET=
UPLOAD_ORIGINS=
