{
  "title": "Cloud Run services",
  "uid": "cloud-run-services",
  "tags": ["secretsource", "gcp", "cloud-run"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "custom",
        "label": "Cloud Run service",
        "query": "gateway,grobid,colbert,colpali",
        "current": { "text": "gateway", "value": "gateway" },
        "options": [
          { "text": "gateway", "value": "gateway", "selected": true },
          { "text": "grobid", "value": "grobid", "selected": false },
          { "text": "colbert", "value": "colbert", "selected": false },
          { "text": "colpali", "value": "colpali", "selected": false }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request count by response code class",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "{{metric.label.response_code_class}}",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_RATE",
            "alignmentPeriod": "60s",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_count",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": ["metric.label.response_code_class"]
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Request latency (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "p50",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "p50",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_PERCENTILE_50",
            "alignmentPeriod": "60s",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_latencies",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": []
          }
        },
        {
          "refId": "B",
          "legendFormat": "p95",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "p95",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_PERCENTILE_95",
            "alignmentPeriod": "60s",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_latencies",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": []
          }
        },
        {
          "refId": "C",
          "legendFormat": "p99",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "p99",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
            "crossSeriesReducer": "REDUCE_NONE",
            "perSeriesAligner": "ALIGN_PERCENTILE_99",
            "alignmentPeriod": "60s",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/request_latencies",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": []
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Instance count",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 8 },
      "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "{{metric.label.state}}",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
            "crossSeriesReducer": "REDUCE_SUM",
            "perSeriesAligner": "ALIGN_MEAN",
            "alignmentPeriod": "60s",
            "filters": [
              "metric.type",
              "=",
              "run.googleapis.com/container/instance_count",
              "AND",
              "resource.label.service_name",
              "=",
              "$service"
            ],
            "groupBys": ["metric.label.state"]
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Container CPU utilization",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 8 },
      "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "refId": "A",
          "legendFormat": "mean",
          "datasource": { "type": "stackdriver", "uid": "gcp-cloud-monitoring" },
          "queryType": "timeSeriesList",
          "aliasBy": "mean",
          "timeSeriesList": {
            "projectName": "gcp-edu-471706",
