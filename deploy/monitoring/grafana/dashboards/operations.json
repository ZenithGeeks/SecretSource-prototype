    {
      "id": 19,
      "title": "Success rate",
      "type": "stat",
      "description": "Done divided by done plus error for analyses started in the selected range; empty when none have finished.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 15
      },
      "datasource": {
        "type": "postgres",
        "uid": "analyses-db"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "analyses-db"
          },
          "format": "table",
          "rawSql": "select\n  case when count(*) filter (where data->>'status' in ('done','error')) = 0 then null\n  else count(*) filter (where data->>'status' = 'done')::float8 / count(*) filter (where data->>'status' in ('done','error'))\n  end as success_rate\nfrom public.analyses\nwhere $__timeFilter(started)",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 20,
