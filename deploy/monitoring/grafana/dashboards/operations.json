      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "analyses-db"
          },
          "format": "time_series",
          "rawSql": "select $__timeGroup(started, '1d') as time,\n  data->>'status' as metric,\n  count(*) as value\nfrom public.analyses\nwhere data->>'status' in ('done', 'error') and $__timeFilter(started)\ngroup by 1, 2\norder by 1",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 21,
      "title": "Run time p50 / p95 (minutes)",
      "type": "stat",
      "description": "Median and 95th percentile run time of finished analyses, first stage to last stage timestamp; runs without timestamps are excluded.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "analyses-db"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "m",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "analyses-db"
          },
          "format": "table",
          "rawSql": "with s as (\n  select id, started, data,\n    (select min((elem->>'at')::double precision) from jsonb_array_elements(coalesce(data->'stages', '[]'::jsonb)) elem where elem ? 'at') as first_at,\n    (select max((elem->>'at')::double precision) from jsonb_array_elements(coalesce(data->'stages', '[]'::jsonb)) elem where elem ? 'at') as last_at\n  from public.analyses\n  where data->>'status' in ('done', 'error') and $__timeFilter(started)\n)\nselect percentile_cont(0.5) within group (order by (last_at - first_at) / 60.0) as \"p50\",\n  percentile_cont(0.95) within group (order by (last_at - first_at) / 60.0) as \"p95\"\nfrom s\nwhere first_at is not null and last_at is not null and last_at > first_at",
          "rawQuery": true
        }
      ]
    },
    {
      "id": 22,
      "title": "Each run",
      "type": "table",
      "description": "The 100 newest analyses in the range with status, run time and last stage; owners and paper titles are deliberately not shown.",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "postgres",
        "uid": "analyses-db"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "done": {
                        "color": "green",
                        "index": 0
                      },
                      "error": {
                        "color": "red",
                        "index": 1
                      },
                      "running": {
                        "color": "blue",
                        "index": 2
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "analyses-db"
          },
          "format": "table",
          "rawSql": "with s as (\n  select id, started, data,\n    (select min((elem->>'at')::double precision) from jsonb_array_elements(coalesce(data->'stages', '[]'::jsonb)) elem where elem ? 'at') as first_at,\n    (select max((elem->>'at')::double precision) from jsonb_array_elements(coalesce(data->'stages', '[]'::jsonb)) elem where elem ? 'at') as last_at\n  from public.analyses\n  where $__timeFilter(started)\n)\nselect id,\n  started,\n  data->>'status' as status,\n  round((case\n    when data->>'status' = 'running' then extract(epoch from (now() - started))\n    when first_at is not null and last_at is not null then last_at - first_at\n  end / 60.0)::numeric, 1) as minutes,\n  data->'stages'->-1->>'stage' as \"last stage\",\n  left(data->>'message', 120) as message\nfrom s\norder by started desc\nlimit 100",
          "rawQuery": true
        }
      ]
    }
  ]
}
