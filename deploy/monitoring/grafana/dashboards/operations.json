      "type": "timeseries",
      "description": "Finished analyses per day by outcome (done or error), by the day they started.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "postgres",
        "uid": "analyses-db"
