# The team setup: the gateway and web app run here with docker compose; GROBID runs here too;
# ColBERT, ColPali and the LLM are the shared services. Copy to .env, fill in every empty
# secret, then: docker compose up -d. Check with: curl localhost:8080/health
# Every setting is explained in .env.example.

# --- network ---
BIND_ADDRESS=

# --- keys ---
# Close to required: most cited papers do not resolve without it.
S2_API_KEY=
UNPAYWALL_EMAIL=

# --- LLM ---
VLLM_URL=https://gateway.9arm.co/v1
VLLM_MODEL=qwen3.8-27b-fp8
# The key for the team LLM gateway.
VLLM_API_KEY=

# --- retrieval and parsing ---
COLBERT_URL=https://colbert-uotp7r3z6a-as.a.run.app
COLPALI_URL=https://colpali-uotp7r3z6a-as.a.run.app
# Empty means the grobid container that compose starts.
GROBID_URL=
SERVICE_AUTH=google-id-token
# Lets the gateway call the Cloud Run services. .env.example says how to make this file.
GOOGLE_APPLICATION_CREDENTIALS=secrets/service-auth.json

# --- persistence and sign-in ---
SUPABASE_URL=https://hecmskknxyssewgnflvy.supabase.co
# Server-only key. Never put it in the web app or in git.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://hecmskknxyssewgnflvy.supabase.co
# Optional, turns on sign-in. Rebuild the web image after setting it: docker compose up -d --build web
VITE_SUPABASE_ANON_KEY=
SESSION_DB_URL=

# Teacher page
VITE_TEACHER_BACKEND=remote
TEACHER_GOOGLE_ENABLED=false
TEACHER_GOOGLE_CLIENT_ID=
TEACHER_GOOGLE_CLIENT_SECRET=
TEACHER_GOOGLE_REDIRECT_URI=http://localhost:5173/api/teacher/google/callback
TEACHER_GOOGLE_ENCRYPTION_KEY=
TEACHER_GOOGLE_SUCCESS_REDIRECT=/?role=teacher&screen=add-class-course
